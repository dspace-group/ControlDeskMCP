{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Open MCP Inspector (connect to running server)",
            "type": "shell",
            "command": "npx",
            "args": [
                "@modelcontextprotocol/inspector",
                "--config",
                ".vscode/mcp-inspector.json"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [
                {
                    "pattern": [
                        {
                            "regexp": "^$",
                            "file": 1,
                            "location": 2,
                            "message": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".",
                        "endsPattern": "."
                    }
                }
            ]
        }
    ]
}
